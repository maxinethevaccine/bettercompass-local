{
  "manifest_version": 3,
  "name": "BetterCompass (local)",
  "version": "1.7.0",
  "description": "Runs the BetterCompass interface inside your own logged-in Compass session. No proxy, no external servers except an optional GitHub update check that can also fetch a newer build.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sjchsdow-nsw.compass.education/bettercompass*"
      ],
      "js": [
        "selfupdate-core.js",
        "bootstrap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://sjchsdow-nsw.compass.education/*"
      ],
      "exclude_matches": [
        "https://sjchsdow-nsw.compass.education/bettercompass*"
      ],
      "js": [
        "selfupdate-core.js",
        "launcher.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sjchsdow-nsw.compass.education/*"
      ],
      "exclude_matches": [
        "https://sjchsdow-nsw.compass.education/bettercompass*"
      ],
      "js": [
        "selfupdate-core.js",
        "finder.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
