{
  "manifest_version": 3,
  "name": "BetterCompass (local)",
  "version": "2.0.4",
  "description": "Runs the BetterCompass interface inside your own logged-in Compass session. No proxy. The only outside server it contacts is GitHub, to download newer versions of itself from this fork's releases.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "https://sjchsdow-nsw.compass.education/*",
    "https://github.com/maxinethevaccine/bettercompass-local/*",
    "https://*.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sjchsdow-nsw.compass.education/bettercompass*"
      ],
      "js": [
        "loader.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://sjchsdow-nsw.compass.education/*"
      ],
      "exclude_matches": [
        "https://sjchsdow-nsw.compass.education/bettercompass*"
      ],
      "js": [
        "launcher.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sjchsdow-nsw.compass.education/*"
      ],
      "exclude_matches": [
        "https://sjchsdow-nsw.compass.education/bettercompass*"
      ],
      "js": [
        "finder.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
